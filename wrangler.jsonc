{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tower-defense-api",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-05",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ENVIRONMENT": "production",
    "FIREBASE_PROJECT_ID": "tower-defense-9f161",
    "ALLOWED_ORIGINS": "https://awsjin510.github.io,http://localhost:5173"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tower-defense",
      "database_id": "a48df5ec-2bf2-4574-9282-1eaf4e22632a",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
